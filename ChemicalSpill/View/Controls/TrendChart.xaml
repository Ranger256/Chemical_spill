<UserControl x:Class="ChemicalSpill.View.Controls.TrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MinHeight="150">

    <!-- График параметра во времени с линиями аварийных уставок (п. 2.1).
         Отрисовка выполняется в коде элемента: внешние библиотеки не используются. -->
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushLight}"
            BorderThickness="1"
            Margin="0,0,0,8">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource PanelHeaderBrush}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="0,0,0,1"
                    Padding="10,5">
                <DockPanel>
                    <TextBlock x:Name="LastValueText"
                               DockPanel.Dock="Right"
                               Style="{StaticResource BaseText}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="CaptionText"
                               Style="{StaticResource BaseText}"
                               FontWeight="SemiBold" />
                </DockPanel>
            </Border>

            <Canvas x:Name="PlotCanvas" Background="White" ClipToBounds="True" />
        </DockPanel>
    </Border>
</UserControl>
