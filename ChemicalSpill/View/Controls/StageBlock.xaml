<UserControl x:Class="ChemicalSpill.View.Controls.StageBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmi="clr-namespace:ChemicalSpill.ViewModels.Items"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vmi:StageViewModel}"
             d:DesignWidth="240">

    <!-- Блок стадии мнемосхемы. Состояние передаётся тремя способами:
         цветом заливки, текстовым наименованием и графическим знаком (п. 2.3). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Стрелка в направлении движения флакона -->
        <TextBlock Grid.Column="0"
                   Text="→"
                   FontSize="18"
                   Margin="1,0,3,0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextMutedBrush}"
                   Visibility="{Binding ShowInboundArrow, Converter={StaticResource BoolToVis}}" />

        <Border Grid.Column="1"
                MinWidth="120"
                MinHeight="140"
                VerticalAlignment="Stretch"
                Background="{Binding State, Converter={StaticResource StageBrush}, ConverterParameter=fill}"
                BorderBrush="{Binding State, Converter={StaticResource StageBrush}, ConverterParameter=stroke}"
                BorderThickness="2"
                CornerRadius="3"
                SnapsToDevicePixels="True">
            <DockPanel Margin="10,8" LastChildFill="False">

                <!-- Наименование, состояние и ключевой параметр -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource BaseText}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding StateGlyph}"
                                   FontSize="14"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding State, Converter={StaticResource StageBrush}, ConverterParameter=text}" />
                        <TextBlock Text="{Binding StateText}"
                                   Style="{StaticResource BaseText}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding State, Converter={StaticResource StageBrush}, ConverterParameter=text}" />
                    </StackPanel>

                    <Border Height="1"
                            Margin="0,7"
                            Background="{Binding State, Converter={StaticResource StageBrush}, ConverterParameter=stroke}"
                            Opacity="0.35" />

                    <TextBlock Text="{Binding KeyCaption}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding KeyValue}"
                               Style="{StaticResource BaseText}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,1,0,0" />

                    <!-- Причина отказа выводится текстом рядом с блоком -->
                    <TextBlock Text="{Binding FaultReason}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource AlarmDarkBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"
                               Visibility="{Binding FaultReason, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>

                <!-- Гнездо ротора и счётчики по станции -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding NestText}"
                               Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding CountersText}"
                               Style="{StaticResource MutedText}"
                               TextAlignment="Right"
                               HorizontalAlignment="Right"
                               Visibility="{Binding HasCounters, Converter={StaticResource BoolToVis}}" />
                </DockPanel>

                <!-- Время выполнения текущей операции и заданный таймаут -->
                <StackPanel DockPanel.Dock="Bottom"
                            Visibility="{Binding HasTimeout, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Время" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TimeText}"
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Right"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <ProgressBar Value="{Binding TimeProgress, Mode=OneWay}"
                                 Maximum="100"
                                 Height="4"
                                 Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
