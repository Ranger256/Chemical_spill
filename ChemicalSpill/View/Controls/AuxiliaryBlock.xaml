<UserControl x:Class="ChemicalSpill.View.Controls.AuxiliaryBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmi="clr-namespace:ChemicalSpill.ViewModels.Items"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vmi:StageViewModel}">

    <!-- Вспомогательный блок: входной шлюз, индексация ротора, выходной шлюз.
         В основной цикл не входит, но влияет на его ход; отображается теми же
         цветами состояний (п. 2.4). -->
    <Border Margin="0,0,8,0"
            Background="{Binding State, Converter={StaticResource StageBrush}, ConverterParameter=fill}"
            BorderBrush="{Binding State, Converter={StaticResource StageBrush}, ConverterParameter=stroke}"
            BorderThickness="1"
            CornerRadius="3"
            SnapsToDevicePixels="True">
        <StackPanel Margin="8,5">
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource BaseText}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock Text="{Binding StateGlyph}"
                           FontSize="13"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center"
                           Foreground="{Binding State, Converter={StaticResource StageBrush}, ConverterParameter=text}" />
                <TextBlock Text="{Binding StateText}"
                           Style="{StaticResource BaseText}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{Binding State, Converter={StaticResource StageBrush}, ConverterParameter=text}" />
            </StackPanel>

            <TextBlock Text="{Binding KeyValue}"
                       Style="{StaticResource MutedText}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
