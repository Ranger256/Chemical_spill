<UserControl x:Class="ChemicalSpill.View.Pages.ParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:ChemicalSpill.View.Controls"
             xmlns:vms="clr-namespace:ChemicalSpill.ViewModels.Sections"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vms:ParametersViewModel}"
             d:DesignWidth="1360" d:DesignHeight="820">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Выбор кривых -->
        <HeaderedContentControl Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <HeaderedContentControl.Header>
                <TextBlock Text="Кривые" />
            </HeaderedContentControl.Header>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Величины выводятся графиками во времени: по одному мгновенному числу нельзя отличить стабильную камеру от камеры, в которой значение медленно растёт."
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,10" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Style="{StaticResource ToolButton}"
                            Content="Выгрузить данные графиков…"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ExportCommand}" />
                    <Button Style="{StaticResource ToolButton}"
                            Content="{Binding PauseText}"
                            HorizontalAlignment="Stretch"
                            Margin="0,6,0,0"
                            Command="{Binding TogglePauseCommand}" />
                    <TextBlock Text="Данные графиков входят в отчёт о партии."
                               Style="{StaticResource MutedText}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Series}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="6,4"
                                        Background="{StaticResource PanelHeaderBrush}"
                                        BorderBrush="{StaticResource BorderBrushLight}"
                                        BorderThickness="1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left"
                                                Width="4"
                                                Margin="0,0,8,0"
                                                Background="{Binding Key, Converter={StaticResource SeriesBrush}}" />
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Caption}"
                                                           Style="{StaticResource BaseText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </HeaderedContentControl>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.4*" />
                <RowDefinition Height="1*" MinHeight="200" />
            </Grid.RowDefinitions>

            <!-- Графики -->
            <HeaderedContentControl Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                <HeaderedContentControl.Header>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Окно наблюдения"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <RadioButton Style="{StaticResource SegmentButton}"
                                         GroupName="TrendWindow"
                                         Content="10 минут"
                                         FontWeight="Normal"
                                         IsChecked="{Binding SelectedWindow, Converter={StaticResource Equals}, ConverterParameter=LastTenMinutes}" />
                            <RadioButton Style="{StaticResource SegmentButton}"
                                         GroupName="TrendWindow"
                                         Content="1 час"
                                         FontWeight="Normal"
                                         IsChecked="{Binding SelectedWindow, Converter={StaticResource Equals}, ConverterParameter=LastHour}" />
                            <RadioButton Style="{StaticResource SegmentButton}"
                                         GroupName="TrendWindow"
                                         Content="Время партии"
                                         FontWeight="Normal"
                                         IsChecked="{Binding SelectedWindow, Converter={StaticResource Equals}, ConverterParameter=CurrentBatch}" />
                        </StackPanel>
                        <TextBlock Text="Графики параметров во времени" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </DockPanel>
                </HeaderedContentControl.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PlottedSeries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ctrl:TrendChart Series="{Binding}"
                                                 LineBrush="{Binding Converter={StaticResource SeriesBrush}}"
                                                 Height="168" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </HeaderedContentControl>

            <!-- Полный перечень параметров -->
            <HeaderedContentControl Grid.Row="1" Style="{StaticResource Card}">
                <HeaderedContentControl.Header>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right"
                                  MinWidth="220"
                                  FontWeight="Normal"
                                  ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedGroup}" />
                        <TextBlock Text="Перечень параметров, выводимых оператору" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </DockPanel>
                </HeaderedContentControl.Header>

                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Parameters}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Параметр" Binding="{Binding Caption}" Width="2.2*" />
                        <DataGridTemplateColumn Header="Значение" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <Border Width="4" Height="14" Margin="0,0,6,0"
                                                Background="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding ValueText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit}" Width="0.7*" />
                        <DataGridTextColumn Header="Диапазон" Binding="{Binding RangeText}" Width="1*" />
                        <DataGridTextColumn Header="Уставка, порог" Binding="{Binding LimitText}" Width="1.4*" />
                        <DataGridTemplateColumn Header="Тип" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Center"
                                            ToolTip="{Binding KindDescription}">
                                        <TextBlock Text="{Binding KindText}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Назначение переносится по словам и не уходит за край таблицы;
                             полный текст доступен подсказкой. -->
                        <DataGridTextColumn Header="Назначение" Binding="{Binding Description}" Width="3*" MinWidth="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Margin" Value="0,4,6,4" />
                                    <Setter Property="ToolTip" Value="{Binding Description}" />
                                    <Setter Property="ToolTipService.ShowDuration" Value="30000" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </HeaderedContentControl>
        </Grid>
    </Grid>
</UserControl>
