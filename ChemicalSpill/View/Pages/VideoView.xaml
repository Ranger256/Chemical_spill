<UserControl x:Class="ChemicalSpill.View.Pages.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:ChemicalSpill.ViewModels.Sections"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vms:VideoViewModel}"
             d:DesignWidth="1360" d:DesignHeight="820">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <HeaderedContentControl Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <HeaderedContentControl.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding StreamText}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Прямая трансляция рабочей камеры" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                </DockPanel>
            </HeaderedContentControl.Header>

            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource AccentButton}"
                            Content="{Binding LightText}"
                            Command="{Binding ToggleLightCommand}"
                            Margin="0,0,6,0" />
                    <Button Style="{StaticResource BaseButton}"
                            Content="Сделать снимок"
                            Command="{Binding SnapshotCommand}"
                            Margin="0,0,6,0" />
                    <Button Style="{StaticResource BaseButton}"
                            Content="Трансляция"
                            Command="{Binding ToggleStreamCommand}" />
                </StackPanel>

                <Border Background="{StaticResource VideoBackgroundBrush}">
                    <Grid>
                        <Image Source="{Binding CurrentFrame, Converter={StaticResource FrameToImage}}" Stretch="Uniform" />

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasFrame, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="▣" FontSize="60" HorizontalAlignment="Center" Foreground="#46525F" />
                            <TextBlock Text="{Binding PlaceholderText}"
                                       FontSize="15"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="#78838F" />
                            <TextBlock Text="Камера внутри рабочей камеры дополняет смотровое окно: она даёт обзор зон, не видимых оператору."
                                       FontSize="13"
                                       MaxWidth="420"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0"
                                       Foreground="#5E6874" />
                        </StackPanel>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#99000000" Padding="8,4" Margin="10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Fill="{Binding IsStreaming, Converter={StaticResource BoolBrush}, ConverterParameter=warning}" />
                                <TextBlock Text="{Binding RecordingText}" FontSize="13" Foreground="#D5DBE3" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>
        </HeaderedContentControl>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <HeaderedContentControl Grid.Row="0" Style="{StaticResource Card}">
                <HeaderedContentControl.Header>
                    <TextBlock Text="Параметры трансляции" />
                </HeaderedContentControl.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Состояние" Style="{StaticResource MutedText}" Margin="0,2,10,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StreamText}" Style="{StaticResource BaseText}" Margin="0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Освещение камеры" Style="{StaticResource MutedText}" Margin="0,2,10,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LightText}" Style="{StaticResource BaseText}" Margin="0,2" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Запись" Style="{StaticResource MutedText}" Margin="0,2,10,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RecordingText}" Style="{StaticResource BaseText}" Margin="0,2" />
                </Grid>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0">
                <HeaderedContentControl.Header>
                    <TextBlock Text="Требования и вопросы" />
                </HeaderedContentControl.Header>

                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                               Text="• Рабочая камера закрыта, поэтому необходим внутренний источник света с управлением из интерфейса." />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                               Text="• Корпус камеры, кабель и оптика находятся внутри чистой инертной зоны: материалы не должны выделять летучие вещества и частицы." />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                               Text="• Требуется указать разрешение, частоту кадров и допустимую задержку трансляции." />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                               Text="• Запись значительно полезнее, если она синхронизирована по времени с журналом параметров: к моменту отбраковки флакона можно посмотреть и цифры, и видео." />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="• При наличии записи определяются глубина архива и место хранения." />
                </StackPanel>
            </HeaderedContentControl>
        </Grid>
    </Grid>
</UserControl>
