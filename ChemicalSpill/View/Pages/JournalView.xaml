<UserControl x:Class="ChemicalSpill.View.Pages.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:ChemicalSpill.ViewModels.Sections"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vms:JournalViewModel}"
             d:DesignWidth="1360" d:DesignHeight="820">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <!-- Журнал -->
        <HeaderedContentControl Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <HeaderedContentControl.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding CountText}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Журнал" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                </DockPanel>
            </HeaderedContentControl.Header>

            <DockPanel>
                <!-- Фильтры -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource PanelHeaderBrush}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        Padding="10,8"
                        Margin="0,0,0,8">
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="С" Style="{StaticResource MutedText}" />
                            <DatePicker SelectedDate="{Binding From}" MinWidth="130" />
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="По" Style="{StaticResource MutedText}" />
                            <DatePicker SelectedDate="{Binding To}" MinWidth="130" />
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Категория" Style="{StaticResource MutedText}" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      MinWidth="180">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Поиск" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" MinWidth="220" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom">
                            <Button Style="{StaticResource ToolButton}"
                                    Content="Выгрузить журнал…"
                                    Command="{Binding ExportCommand}" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Items}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="150" />
                        <DataGridTextColumn Header="Категория" Binding="{Binding CategoryText}" Width="150" />
                        <DataGridTextColumn Header="Событие" Binding="{Binding Event}" Width="3*" />
                        <DataGridTextColumn Header="Прежнее значение" Binding="{Binding OldValue}" Width="1.4*" />
                        <DataGridTextColumn Header="Новое значение" Binding="{Binding NewValue}" Width="1.8*" />
                        <DataGridTextColumn Header="Оператор" Binding="{Binding OperatorName}" Width="130" />
                        <DataGridTextColumn Header="Состояние" Binding="{Binding StateText}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </HeaderedContentControl>

        <!-- Отчёт о партии и память журнала -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <HeaderedContentControl Grid.Row="0" Style="{StaticResource Card}">
                <HeaderedContentControl.Header>
                    <TextBlock Text="Отчёт о партии" />
                </HeaderedContentControl.Header>

                <StackPanel>
                    <TextBlock Text="Партия" Style="{StaticResource MutedText}" />
                    <ComboBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" Margin="0,2,0,8" />

                    <TextBlock Text="Состав отчёта" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding ReportContents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock DockPanel.Dock="Left" Text="•" Width="12" Style="{StaticResource BaseText}" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource BaseText}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource AccentButton}"
                            Content="Сформировать отчёт"
                            HorizontalAlignment="Stretch"
                            Margin="0,10,0,0"
                            Command="{Binding BuildReportCommand}" />

                    <TextBlock Text="Отчёт ссылается на наименование рецепта, номер версии и контрольную сумму — без этого прослеживаемость теряется."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0">
                <HeaderedContentControl.Header>
                    <TextBlock Text="Память журнала установки" />
                </HeaderedContentControl.Header>

                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Style="{StaticResource SubheadText}">
                            <Run Text="{Binding MemoryPercent, Mode=OneWay}" />
                            <Run Text=" %" />
                        </TextBlock>
                        <TextBlock Text="Заполнение" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ProgressBar Value="{Binding MemoryPercent, Mode=OneWay}" Maximum="100" Margin="0,6,0,0" />

                    <TextBlock Text="{Binding MemoryText}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <Border Margin="0,8,0,0" Padding="8,6"
                            Visibility="{Binding MemoryWarning, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource WarningSoftBrush}"
                            BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="1">
                        <TextBlock Text="Заполнение достигло 80 %. Наиболее старые записи будут замещены новыми; остановка работы установки из-за переполнения журнала не допускается."
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0">
                <HeaderedContentControl.Header>
                    <TextBlock Text="Правила журналирования" />
                </HeaderedContentControl.Header>

                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                               Text="• Параметры типа «И» и «Р» записываются с единой меткой времени; период записи назначается отдельно для каждой величины." />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                               Text="• Изменения уставок «У» и «А» записываются с прежним и новым значением, временем и оператором." />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                               Text="• Каждое нажатие органа управления записывается с указанием времени, оператора и состояния установки." />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="• Все подключения, отключения и неудачные попытки записываются с адресом и именем компьютера." />
                </StackPanel>
            </HeaderedContentControl>
        </Grid>
    </Grid>
</UserControl>
