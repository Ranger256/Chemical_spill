<UserControl x:Class="ChemicalSpill.View.Pages.RecipesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:ChemicalSpill.ViewModels.Sections"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vms:RecipesViewModel}"
             d:DesignWidth="1360" d:DesignHeight="820">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,12,2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" MinWidth="420" />
            <ColumnDefinition Width="1.3*" />
        </Grid.ColumnDefinitions>

        <!-- Список рецептов -->
        <HeaderedContentControl Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <HeaderedContentControl.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding LoadedText}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Рецепты" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                </DockPanel>
            </HeaderedContentControl.Header>

            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Style="{StaticResource ToolButton}" Content="Создать" Command="{Binding CreateCommand}" Margin="0,0,6,6" />
                    <Button Style="{StaticResource ToolButton}" Content="Копировать" Command="{Binding CopyCommand}" Margin="0,0,6,6" />
                    <Button Style="{StaticResource ToolButton}" Content="Сохранить черновик" Command="{Binding SaveCommand}" Margin="0,0,6,6" />
                    <Button Style="{StaticResource ToolButton}" Content="Проверен" Command="{Binding VerifyCommand}" Margin="0,0,6,6" />
                    <Button Style="{StaticResource ToolButton}" Content="Утвердить" Command="{Binding ApproveCommand}" Margin="0,0,6,6" />
                    <Button Style="{StaticResource ToolButton}" Content="В архив" Command="{Binding ArchiveCommand}" Margin="0,0,6,6" />
                    <Button Style="{StaticResource AccentButton}" Content="Загрузить в установку" Command="{Binding LoadCommand}" Margin="0,0,6,6" Padding="9,4" />
                    <Button Style="{StaticResource ToolButton}" Content="Экспорт…" Command="{Binding ExportCommand}" Margin="0,0,6,6" />
                    <Button Style="{StaticResource ToolButton}" Content="Импорт…" Command="{Binding ImportCommand}" Margin="0,0,0,6" />
                </WrapPanel>

                <!-- Результаты проверок при сохранении и загрузке -->
                <Border DockPanel.Dock="Bottom"
                        Margin="0,8,0,0"
                        Background="{StaticResource PanelHeaderBrush}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        Padding="10,8"
                        MaxHeight="220">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Результат проверки"
                                   Style="{StaticResource BaseText}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Проверки не выполнялись. Выполните загрузку или сохранение рецепта."
                                   Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Checks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Checks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="{Binding Glyph}"
                                                       Width="16"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding Passed, Converter={StaticResource BoolBrush}}" />
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding Detail}"
                                                       Style="{StaticResource MutedText}"
                                                       MaxWidth="200"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource BaseText}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <DataGrid Style="{StaticResource DataTable}"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="2*" MinWidth="140" />
                        <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="55" />
                        <DataGridTemplateColumn Header="Состояние" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Margin="6,2"
                                            CornerRadius="2"
                                            Padding="6,1"
                                            HorizontalAlignment="Left"
                                            Background="{Binding State, Converter={StaticResource RecipeStateBrush}}">
                                        <TextBlock Text="{Binding StateText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Продукт" Binding="{Binding Product}" Width="1.6*" MinWidth="120" />
                        <DataGridTextColumn Header="Тара" Binding="{Binding VialText}" Width="62" />
                        <DataGridTextColumn Header="Доза" Binding="{Binding DoseText}" Width="76" />
                        <DataGridTextColumn Header="Изменён" Binding="{Binding ModifiedText}" Width="112" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </HeaderedContentControl>

        <!-- Состав рецепта -->
        <HeaderedContentControl Grid.Column="1" Style="{StaticResource Card}">
            <HeaderedContentControl.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding HeaderText}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Состав рецепта" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                </DockPanel>
            </HeaderedContentControl.Header>

            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        Padding="10,7"
                        Margin="0,0,0,8">
                    <TextBlock Text="{Binding EditabilityText}"
                               Style="{StaticResource BaseText}"
                               TextWrapping="Wrap" />
                </Border>

                <TabControl Background="Transparent"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            IsEnabled="{Binding IsEditable}">

                    <TabItem Header="1. Идентификация">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование рецепта" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.Summary.Name}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Номер версии" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" IsReadOnly="True" Text="{Binding Document.Summary.Version, Mode=OneWay}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Наименование продукта" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.Summary.Product}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Автор" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" IsReadOnly="True" Text="{Binding Document.Summary.Author, Mode=OneWay}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Последнее изменение" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" IsReadOnly="True" Text="{Binding Document.Summary.ModifiedAt, Mode=OneWay}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Контрольная сумма" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}" IsReadOnly="True" Text="{Binding Document.Summary.Checksum, Mode=OneWay}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Комментарий" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}"
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         Text="{Binding Document.Summary.Comment}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="2. Тара и оснастка">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Типоразмер флакона, мл" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.VialSizeMl}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип ротора" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.RotorType}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Число гнёзд" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.NestCount}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Высота горловины, мм" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.NeckHeightMm}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Диаметр горловины, мм" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.NeckDiameterMm}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Тип затвора" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.ClosureType}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="3. Свойства продукта">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Плотность при реперной t, г/см³" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.DensityAtReference}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Реперная температура, °C" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.ReferenceTemperature}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Температурный коэффициент, %/°C" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.TemperatureCoefficient}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Температура продукта, мин. °C" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.ProductTemperatureMin}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Температура продукта, макс. °C" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.ProductTemperatureMax}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Особые указания" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}"
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         Text="{Binding Document.ProductNotes}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="4. Дозирование">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Доза, мл" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.DoseMl}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Допуск отклонения дозы, %" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.DoseTolerancePercent}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Скорость основной фазы, мл/с" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.MainPhaseRate}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Скорость завершающей фазы, мл/с" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.FinalPhaseRate}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Точка перехода фаз, % дозы" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.PhaseSwitchPercent}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Время стабилизации весов, с" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.ScaleSettlingSeconds}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Задержка отвода сопла, с" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.NozzleRetractDelaySeconds}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Таймаут наполнения, с" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.FillTimeoutSeconds}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="5. Укупорка">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Момент затяжки, Н·м" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.CapTorqueNm}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Допуск момента, Н·м" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.CapTorqueToleranceNm}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Угол затяжки, мин. °" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.CapAngleMinDeg}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Угол затяжки, макс. °" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.CapAngleMaxDeg}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Скорость завинчивания, об/мин" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.CapSpeedRpm}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Время удержания, с" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.CapHoldSeconds}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Число попыток" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.CapAttempts}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Таймаут укупорки, с" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.CapTimeoutSeconds}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="6. Атмосфера">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Рабочий газ" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                                         Text="{Binding Document.Gas, Converter={StaticResource EnumDisplay}, Mode=OneWay}" IsReadOnly="True" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Предельное содержание O₂, ppm" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.OxygenLimitPpm}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Предельное содержание H₂O, ppm" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.MoistureLimitPpm}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Уставка избыточного давления, мбар" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.PressureSetpointMbar}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Нижняя граница давления, мбар" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.PressureLowMbar}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Верхняя граница давления, мбар" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.PressureHighMbar}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Число циклов продувки шлюза" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.GatePurgeCycles}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="7. Цикл">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Скорость подачи, %" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.FeedSpeedPercent}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Таймаут подачи, с" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.FeedTimeoutSeconds}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Скорость поворота ротора, %" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.RotorSpeedPercent}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Выдержка после поворота, с" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.RotorSettlingSeconds}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Скорость выгрузки, %" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.DischargeSpeedPercent}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Таймаут выгрузки, с" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.DischargeTimeoutSeconds}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Пауза между циклами, с" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Document.PauseBetweenCyclesSeconds}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Правило сортировки" Style="{StaticResource FieldLabel}" />
                                <ItemsControl Grid.Row="7" Grid.Column="1" ItemsSource="{Binding Document.SortingRule}" Margin="0,2,12,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource BaseText}"
                                                       Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </HeaderedContentControl>
    </Grid>
</UserControl>
