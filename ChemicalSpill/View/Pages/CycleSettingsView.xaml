<UserControl x:Class="ChemicalSpill.View.Pages.CycleSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:ChemicalSpill.ViewModels.Sections"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vms:CycleSettingsViewModel}"
             d:DesignWidth="1360" d:DesignHeight="820">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Перечень настроек по стадиям -->
        <HeaderedContentControl Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <HeaderedContentControl.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding RecipeText}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Настройки цикла" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                </DockPanel>
            </HeaderedContentControl.Header>

            <DockPanel>
                <!-- Признак доступности изменения -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource WarningSoftBrush}"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        Padding="10,7"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding AvailabilityText}"
                                   Style="{StaticResource BaseText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Каждое изменение записывается в журнал с прежним значением, новым значением, временем и именем оператора."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- Шапка таблицы настроек -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Настройка и назначение" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Значение" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Ед. изм." Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Диапазон" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Смена в работе" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <Border Background="{StaticResource AccentSoftBrush}"
                                            BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,5">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource BaseText}"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrushLight}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="8,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.4*" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="120" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Caption}"
                                                                       Style="{StaticResource BaseText}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Purpose}"
                                                                       Style="{StaticResource MutedText}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding Message}"
                                                                       Style="{StaticResource CaptionText}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AlarmBrush}"
                                                                       Margin="0,3,0,0"
                                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>

                                                        <Grid Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Top">
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                                     IsEnabled="{Binding IsEditable}"
                                                                     Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                                            <ComboBox ItemsSource="{Binding Options}"
                                                                      SelectedItem="{Binding Value}"
                                                                      IsEnabled="{Binding IsEditable}"
                                                                      Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Unit}"
                                                                   Style="{StaticResource BaseText}"
                                                                   VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RangeText}" Style="{StaticResource BaseText}" />
                                                            <TextBlock Style="{StaticResource MutedText}">
                                                                <Run Text="по умолч. " />
                                                                <Run Text="{Binding DefaultText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <Border Grid.Column="4"
                                                                Style="{StaticResource Badge}"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <Border.ToolTip>
                                                                <TextBlock Text="Настройки делятся на изменяемые в ходе работы и требующие останова цикла." />
                                                            </Border.ToolTip>
                                                            <TextBlock Text="{Binding ChangeableText}" Style="{StaticResource BadgeText}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </HeaderedContentControl>

        <!-- Расчёт времени такта -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <HeaderedContentControl Grid.Row="0" Style="{StaticResource Card}">
                <HeaderedContentControl.Header>
                    <TextBlock Text="Расчёт времени такта" />
                </HeaderedContentControl.Header>

                <StackPanel>
                    <TextBlock Text="{Binding TactExplanation}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1. Подача флакона" Style="{StaticResource BaseText}" Margin="0,2" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FeedDurationText}" Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="2. Наполнение" Style="{StaticResource BaseText}" Margin="0,2" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FillDurationText}" Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,2" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="3. Укупорка" Style="{StaticResource BaseText}" Margin="0,2" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CapDurationText}" Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,2" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="4. Выдача флакона" Style="{StaticResource BaseText}" Margin="0,2" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DischargeDurationText}" Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,2" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Индексация ротора" Style="{StaticResource BaseText}" Margin="0,2" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IndexingText}" Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,2" />
                    </Grid>

                    <Separator />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding TactText}"
                                   Style="{StaticResource SubheadText}" />
                        <TextBlock Text="Время такта установки" Style="{StaticResource BaseText}" FontWeight="SemiBold" />
                    </DockPanel>

                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ThroughputText}"
                                   Style="{StaticResource SubheadText}"
                                   Foreground="{Binding MeetsRequirement, Converter={StaticResource BoolBrush}}" />
                        <TextBlock Text="Ожидаемая производительность" Style="{StaticResource BaseText}" FontWeight="SemiBold" />
                    </DockPanel>

                    <Border Margin="0,8,0,0" Padding="8,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Background" Value="{StaticResource OkSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource OkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MeetsRequirement}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource AlarmSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AlarmBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RequirementText}"
                                   Style="{StaticResource BaseText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </Border>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding LimitingStageText}"
                                   Style="{StaticResource BaseText}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Стадия, ограничивающая производительность" Style="{StaticResource MutedText}" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource AccentButton}"
                                Content="Сохранить в рецепт…"
                                Command="{Binding SaveToRecipeCommand}"
                                Margin="0,0,6,0" />
                        <Button Style="{StaticResource BaseButton}"
                                Content="Значения по умолчанию"
                                Command="{Binding ResetToDefaultsCommand}" />
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0">
                <HeaderedContentControl.Header>
                    <TextBlock Text="Общие правила" />
                </HeaderedContentControl.Header>

                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                               Text="• Все настройки хранятся в рецепте, привязанном к продукту и типоразмеру тары." />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                               Text="• Для каждой настройки заданы минимальное и максимальное значения. Ввод вне диапазона отклоняется с пояснением причины." />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                               Text="• Настройки с признаком «только на стопе» требуют останова цикла." />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                               Text="• Право изменения настроек определяется ролью пользователя." />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="• Расчёт позволяет увидеть последствия изменения настройки до запуска цикла, а не после выпуска бракованной партии." />
                </StackPanel>
            </HeaderedContentControl>
        </Grid>
    </Grid>
</UserControl>
